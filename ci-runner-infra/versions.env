# Pins for the ci-runner-infra image. build.sh reads this file; CI path-filters on it, so a
# bump here rebuilds and publishes the image.
#
# RUNNER_VERSION       ghcr.io/actions/actions-runner base tag; keep it with ci-runner-node's.
#                      The runner binary updates itself in a pod when GitHub requires it, so
#                      this is the floor, not the ceiling.
# ANSIBLE_CORE_VERSION ansible-core, NOT the batteries-included `ansible` distribution: the
# ANSIBLE_LINT_VERSION distribution ships ~100 collections and would hide an undeclared one.
#                      Both live in /opt/venv, which the runner user can write, so a workflow's
#                      own pins win at job time; these only make the common case a no-op.
# YQ_VERSION / _SHA256 mikefarah/yq release binary yq_linux_amd64.
# GITLEAKS_* / _SHA256 gitleaks release tarball gitleaks_<v>_linux_x64.tar.gz.
# PWSH_VERSION         PowerShell 7 LTS; tarball powershell-<v>-linux-x64.tar.gz. Its SHA256
#                      is checked against the release's own hashes.sha256 on every bump.
RUNNER_VERSION=2.338.1
ANSIBLE_CORE_VERSION=2.21.5
ANSIBLE_LINT_VERSION=26.10.1
YQ_VERSION=4.54.1
YQ_SHA256=8e34fc298390875de416e6a4afcb8cabeceb25d9aa8506c1a2f9353cf702ea5f
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
PWSH_VERSION=7.6.9
PWSH_SHA256=1da6d6d6035d651f20e70ddee7c4c15ac6ab8b9fb40ee92240d91263f28a884b
