# Pins for the ci-runner-node image. build.sh reads this file; CI path-filters on it, so a
# bump here rebuilds and publishes the image.
#
# RUNNER_VERSION   ghcr.io/actions/actions-runner base tag. The runner binary updates itself
#                  inside a pod when GitHub requires it, so this pin is the floor, not the
#                  ceiling; move it when the weekly rebuild starts logging an update.
# NODE_VERSION     Node 24 (Active LTS "Krypton", EOL 2028-04-30). Placed in RUNNER_TOOL_CACHE
#                  so actions/setup-node `node-version: 24` finds it and downloads nothing.
#                  Verify NODE_SHA256 against nodejs.org's SHASUMS256.txt on every bump.
# PNPM_VERSION     Match the consuming projects' `packageManager` field (pnpm/action-setup
#                  reads that at job time; this one is for the image's own proof and ad-hoc use).
# PLAYWRIGHT_VERSION  Match the consuming projects' `@playwright/test`. Chromium's apt library
#                  set is installed with this release's `install-deps`, and its Chromium build is
#                  pre-fetched, so a workflow's browser install is a no-op. A project on a newer
#                  Playwright still works: the libraries rarely change, and the browser installs
#                  at job time.
RUNNER_VERSION=2.338.1
NODE_VERSION=24.22.1
PNPM_VERSION=12.3.4
PLAYWRIGHT_VERSION=1.63.0
NODE_SHA256=eb6728e77c576a35162c122c45ccadf224d89ff00abc8dae46cc2897c6002d7c # node-v24.22.1-linux-x64.tar.gz
